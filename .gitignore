# Data
# Bloomberg data can't be redistributed, so none of it goes public
# anchored to the repo root so the credit_engine/data/ package isn't caught
/data/
/Data/
/raw/
*.xlsx
*.xlsm
*.xls
*.csv
*.parquet
*.pkl
*.pickle
*.feather
*.h5
*.hdf5

# Exploration notebooks. Saved outputs (tables, plots) contain Bloomberg data
/notebooks/

# Bloomberg output. Kept to output folders and non-code files, so a loader module like bloomberg.py can still be committed
bbg_output/
bloomberg_output/
*.bbg
*.txt.bbg

